APP_ENV=development
# Optional: leave unset for local SQLite (./datadash.db).
# For local PostgreSQL, uncomment and update this URL:
# DATABASE_URL=postgresql+psycopg2://datadash:datadash@localhost:5432/datadash
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (32+ chars required in production)
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_ROWS=200000
MAX_COLS=200
MAX_DATASETS_PER_USER=20
RATE_LIMIT_ENABLED=true
# Set true only behind nginx (it sets X-Real-IP); otherwise clients could fake their IP.
TRUST_PROXY=false
