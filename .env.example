# Docker Compose configuration. Copy to .env and replace both values.
# Use URL-safe secrets because POSTGRES_PASSWORD is embedded in DATABASE_URL.
# Generate each value independently:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-random-password
SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters

# Public browser origin(s), comma-separated. Use your HTTPS domain in production.
CORS_ORIGINS=http://localhost:8081

# Local host port. The app binds to loopback; expose it publicly only through HTTPS reverse proxy.
DATADASH_PORT=8081
